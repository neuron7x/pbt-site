# ПБТ · ПолтаваБудТехніка — сайт + API заявок. Встановлення: ops/install.sh
[Unit]
Description=ПБТ site + lead API (127.0.0.1:4180)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=%h/projects/pbt-site
ExecStart=/usr/bin/python3 server/app.py
# за локальним реверс-проксі (Tailscale Funnel): довіряти X-Forwarded-For/-Proto від loopback (у коді за замовчуванням — ні)
Environment=TRUST_PROXY=1
Restart=always
RestartSec=2
TimeoutStopSec=10
# Measured (ops/sandbox_probe.py --manager user): cgroup limits and NoNewPrivileges hold. Filesystem
# isolation does NOT: without unprivileged user namespaces the process can read and write the whole home.
# That boundary needs the system-manager candidate in ops/systemd/system/, which is an owner deployment decision.
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=512M
TasksMax=256
UMask=0077

[Install]
WantedBy=default.target
